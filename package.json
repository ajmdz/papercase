{
  "name": "papercase",
  "productName": "Papercase",
  "version": "0.0.0",
  "description": "A local desktop reading library for EPUB and PDF materials.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build --config vite.config.ts",
    "preview": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write package.json README.md tsconfig*.json vite.config.ts vitest.config.ts eslint.config.mjs scripts src --ignore-unknown",
    "format:check": "prettier --check package.json README.md tsconfig*.json vite.config.ts vitest.config.ts eslint.config.mjs scripts src --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "electron",
    "epub",
    "pdf",
    "reader"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "epubjs": "^0.3.93",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
